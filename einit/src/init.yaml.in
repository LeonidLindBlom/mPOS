entities:

- name: controlsys.ControlSys
  autostart: true
  command: /ControlSys
  args: []
  connections:
  - target: env.Env
    id: {var: ENV_SERVICE_NAME, include: env/env.h}
  @INIT_ControlSys_ENTITY_CONNECTIONS@

- name: env.Env
  autostart: true
  command: /Env
  args: []

@INIT_EXTERNAL_ENTITIES@
