assert "transaction_flow" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        inputguard <- execute src=einit dst=controlsys.InputGuard
        output <- execute src=einit dst=controlsys.OutputController
        cardverif <- execute src=einit dst=controlsys.CardVerifier
        txn <- execute src=einit dst=controlsys.TransactionGenerator
        statusverif <- execute src=einit dst=controlsys.StatusVerifier
        journal <- execute src=einit dst=controlsys.Journal
    }

    sequence "heartbeat" {
        grant "ControlSys polls InputGuard" request src=manager dst=inputguard endpoint=inputguard.interface method=Heartbeat {
            networkOk : true, pingOk : true, powerOk : true,
            signalStrength : 90, soc : 85
        }
        grant "InputGuard reports readiness" response src=inputguard dst=manager endpoint=inputguard.interface method=Heartbeat {
            powerReady : true, networkReady : true
        }
    }

    sequence "amount" {
        grant "ControlSys requests transaction start" request src=manager dst=inputguard endpoint=inputguard.interface method=BeginTransaction {
            amountCents : 12345, currency : "RUB"
        }
        grant "InputGuard allows continuation" response src=inputguard dst=manager endpoint=inputguard.interface method=BeginTransaction {
            allowed : true
        }
        grant "ControlSys invites customer" request src=manager dst=output endpoint=output.interface method=InviteCard {
            txId : "20251203T193615Z-0001", amountCents : 12345, currency : "RUB"
        }
    }

    sequence "card" {
        grant "ControlSys validates card" request src=manager dst=cardverif endpoint=cardverif.interface method=CheckCard {
            panMasked : "4256********9310", expiry : "2712",
            holder : "CARDHOLDER", emvOk : true
        }
        grant "Card verifier approves" response src=cardverif dst=manager endpoint=cardverif.interface method=CheckCard {
            accepted : true
        }
    }

    sequence "pin" {
        grant "ControlSys asks for PIN" request src=manager dst=output endpoint=output.interface method=RequestPIN {
            txId : "20251203T193615Z-0001"
        }
    }

    sequence "bank" {
        grant "ControlSys builds ARQC" request src=manager dst=txn endpoint=txn.interface method=Build {
            txId : "20251203T193615Z-0001", amountCents : 12345,
            currency : "RUB", approved : true
        }
        grant "Transaction payload ready" response src=txn dst=manager endpoint=txn.interface method=Build {
            payload : "ARQC"
        }
        grant "ControlSys validates status" request src=manager dst=statusverif endpoint=statusverif.interface method=Validate {
            txId : "20251203T193615Z-0001", seqNumber : 1,
            approved : true, latencyMs : 120
        }
        grant "Status verifier confirms" response src=statusverif dst=manager endpoint=statusverif.interface method=Validate {
            ok : true
        }
        grant "Journal records transaction" request src=manager dst=journal endpoint=journal.interface method=Append {
            txId : "20251203T193615Z-0001", amountCents : 12345,
            currency : "RUB", approved : true
        }
        grant "Journal acknowledges" response src=journal dst=manager endpoint=journal.interface method=Append {
            ok : true
        }
    }

    sequence "status" {
        grant "ControlSys shows success" request src=manager dst=output endpoint=output.interface method=ShowStatus {
            message : "Операция подтверждена"
        }
    }

    sequence "receipt" {
        grant "ControlSys prints receipt" request src=manager dst=output endpoint=output.interface method=PrintReceipt {
            txId : "20251203T193615Z-0001", amountCents : 12345,
            currency : "RUB", approved : true
        }
    }
}

assert "update_flow" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        auth <- execute src=einit dst=controlsys.AuthModule
        loader <- execute src=einit dst=controlsys.UpdateLoader
        storage <- execute src=einit dst=controlsys.UpdateStorage
        verifier <- execute src=einit dst=controlsys.UpdateVerifier
        installer <- execute src=einit dst=controlsys.UpdateInstaller
    }

    sequence "request" {
        grant "ControlSys resets storage" request src=manager dst=storage endpoint=storage.interface method=Reset {}
        grant "ControlSys authenticates operator" request src=manager dst=auth endpoint=auth.interface method=CheckRole {
            role : "operator"
        }
        grant "Auth approves operator" response src=auth dst=manager endpoint=auth.interface method=CheckRole {
            accepted : true
        }
        grant "ControlSys starts loader" request src=manager dst=loader endpoint=loader.interface method=Begin {
            requester : "operator"
        }
        grant "Loader ready" response src=loader dst=manager endpoint=loader.interface method=Begin {
            ok : true
        }
    }

    sequence "chunks" {
        grant "Chunk 1 uploaded" request src=manager dst=loader endpoint=loader.interface method=PushChunk {
            version : "1.0.1", chunkIndex : 1, chunkTotal : 2,
            chunkSize : 1048576, signatureHint : true
        }
        grant "Loader accepts chunk 1" response src=loader dst=manager endpoint=loader.interface method=PushChunk {
            ok : true
        }
        grant "Chunk 2 uploaded" request src=manager dst=loader endpoint=loader.interface method=PushChunk {
            version : "1.0.1", chunkIndex : 2, chunkTotal : 2,
            chunkSize : 1048576, signatureHint : true
        }
        grant "Loader accepts chunk 2" response src=loader dst=manager endpoint=loader.interface method=PushChunk {
            ok : true
        }
        grant "Loader finalizes session" request src=manager dst=loader endpoint=loader.interface method=Finalize {}
        grant "Loader finished" response src=loader dst=manager endpoint=loader.interface method=Finalize {
            ok : true
        }
    }

    sequence "snapshot" {
        grant "ControlSys snapshots storage" request src=manager dst=storage endpoint=storage.interface method=Snapshot {}
        grant "Storage reports assembled image" response src=storage dst=manager endpoint=storage.interface method=Snapshot {
            version : "1.0.1", totalSize : 2097152, complete : true
        }
    }

    sequence "verify-signature" {
        grant "Verifier checks bundle" request src=manager dst=verifier endpoint=verifier.interface method=Verify {
            version : "1.0.1", totalSize : 2097152, signatureOk : true
        }
        grant "Verifier approves" response src=verifier dst=manager endpoint=verifier.interface method=Verify {
            ok : true
        }
    }

    sequence "install" {
        grant "Installer applies image" request src=manager dst=installer endpoint=installer.interface method=Install {
            version : "1.0.1", totalSize : 2097152, allow : 1
        }
        grant "Installer confirms" response src=installer dst=manager endpoint=installer.interface method=Install {
            ok : 1
        }
    }
}

assert "log_export_flow" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        auth <- execute src=einit dst=controlsys.AuthModule
        journal <- execute src=einit dst=controlsys.Journal
        output <- execute src=einit dst=controlsys.OutputController
    }

    sequence "auth" {
        grant "ControlSys authenticates engineer" request src=manager dst=auth endpoint=auth.interface method=CheckRole {
            role : "engineer"
        }
        grant "Auth grants access" response src=auth dst=manager endpoint=auth.interface method=CheckRole {
            accepted : true
        }
    }

    sequence "export" {
        grant "ControlSys requests journal export" request src=manager dst=journal endpoint=journal.interface method=Export {
            maxRecords : 2
        }
        grant "Journal streams record #1" response src=journal dst=manager endpoint=journal.interface method=Export {
            record : "tx=20251202T120000Z-0001"
        }
        grant "Journal streams record #2" response src=journal dst=manager endpoint=journal.interface method=Export {
            record : "tx=20251202T120501Z-0002"
        }
    }

    sequence "export-complete" {
        grant "Journal signals completion" response src=journal dst=manager endpoint=journal.interface method=Export {
            record : "DONE"
        }
        grant "ControlSys reports status" request src=manager dst=output endpoint=output.interface method=ShowStatus {
            message : "Выгрузка завершена"
        }
    }
}
