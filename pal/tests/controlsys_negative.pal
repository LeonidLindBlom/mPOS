assert "negative_unsigned_transaction" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.Manager
        txn <- execute src=einit dst=controlsys.TransactionGenerator
    }

    sequence "ui-bypass-attempt" {
        grant "Unprotected UI forms packet" request src=ui dst=manager endpoint=ui.channel method=InjectRaw {
            payload : "raw-bytes", signature : false
        }
    }

    sequence "manager-rejects-unsigned" {
        grant "Manager rejects unsigned tx" response src=manager dst=ui endpoint=ui.channel method=InjectRaw {
            error : "NO_SIGNATURE"
        }
    }
}

assert "negative_journal_loss" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        journal <- execute src=einit dst=controlsys.Journal
    }

    sequence "restart-detected" {
        grant "Journal detects previous shutdown" request src=journal dst=journal endpoint=journal.service method=IntegrityCheck {
            tailHash : "abc"
        }
    }

    sequence "prevent-overwrite" {
        grant "Journal switches to recovery" response src=journal dst=manager endpoint=journal.service method=IntegrityCheck {
            mode : "append-only"
        }
    }
}

assert "negative_corrupted_update" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        loader <- execute src=einit dst=controlsys.UpdateLoader
        verifier <- execute src=einit dst=controlsys.UpdateVerifier
    }

    sequence "corrupted-image" {
        grant "Loader assembled corrupted file" request src=loader dst=verifier endpoint=verifier.service method=Verify {
            version : "1.0.1", signatureOk : false
        }
    }

    sequence "verifier-fails" {
        grant "Verifier blocks installation" response src=verifier dst=loader endpoint=verifier.service method=Verify {
            ok : false, reason : "SIGNATURE_ERROR"
        }
    }
}

assert "negative_card_data_corruption" {
    setup {
        cardverif <- execute dst=controlsys.CardVerifier
    }

    sequence "invalid-track" {
        grant "Card verifier rejects corrupted track" response src=cardverif dst=manager endpoint=cardverifier.service method=CheckCard {
            emvOk : false, error : "CRC_FAIL"
        }
    }
}

assert "negative_replayed_bank_response" {
    setup {
        statusverif <- execute dst=controlsys.StatusVerifier
    }

    sequence "replay-detected" {
        grant "Status verifier sees old seq" response src=statusverif dst=manager endpoint=statusverifier.service method=Validate {
            ok : false, error : "REPLAY"
        }
    }
}

assert "negative_receipt_without_journal" {
    setup {
        manager <- execute dst=controlsys.Manager
        output <- execute dst=controlsys.OutputController
        journal <- execute dst=controlsys.Journal
    }

    sequence "receipt-blocked" {
        grant "Manager refuses to print until journal write" response src=manager dst=output endpoint=output.service method=PrintReceipt {
            error : "JOURNAL_PENDING"
        }
    }
}

assert "negative_power_drop_before_card" {
    setup {
        inputguard <- execute dst=controlsys.InputGuard
    }

    sequence "battery-low" {
        grant "InputGuard halts FSM" response src=inputguard dst=manager endpoint=inputguard.service method=Heartbeat {
            powerOK : false, block : true
        }
    }
}

assert "negative_third_party_app" {
    setup {
        manager <- execute dst=controlsys.Manager
        cardverif <- execute dst=controlsys.CardVerifier
    }

    sequence "forged-source" {
        grant "Manager requests source proof" request src=manager dst=cardverif endpoint=cardverifier.service method=CheckCard {
            source : "untrusted"
        }
        grant "Card verifier rejects" response src=cardverif dst=manager endpoint=cardverifier.service method=CheckCard {
            emvOk : false, error : "UNAUTHORIZED_SOURCE"
        }
    }
}

assert "negative_update_low_battery" {
    setup {
        power <- execute dst=controlsys.PowerVerifier
        installer <- execute dst=controlsys.UpdateInstaller
    }

    sequence "battery-warning" {
        grant "Power verifier warns" response src=power dst=installer endpoint=power.service method=CheckPower {
            ok : false, reason : "LOW_BATTERY"
        }
    }

    sequence "install-aborted" {
        grant "Installer aborts" response src=installer dst=manager endpoint=installer.service method=Install {
            ok : false, error : "POWER_FAIL"
        }
    }
}
