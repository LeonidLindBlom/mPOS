assert "negative_unsigned_transaction" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        statusverif <- execute src=einit dst=controlsys.StatusVerifier
        output <- execute src=einit dst=controlsys.OutputController
    }

    sequence "ui-bypass-attempt" {
        grant "ControlSys detects replay" request src=manager dst=statusverif endpoint=statusverif.interface method=Validate {
            txId : "20251203T200000Z-0007", seqNumber : 7,
            approved : true, latencyMs : 15
        }
        grant "Status verifier rejects response" response src=statusverif dst=manager endpoint=statusverif.interface method=Validate {
            ok : false
        }
    }

    sequence "manager-rejects-unsigned" {
        grant "ControlSys reports error" request src=manager dst=output endpoint=output.interface method=ShowError {
            message : "Ответ банка отклонён"
        }
    }
}

assert "negative_journal_loss" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        journal <- execute src=einit dst=controlsys.Journal
        output <- execute src=einit dst=controlsys.OutputController
    }

    sequence "journal-rejects" {
        grant "ControlSys attempts to append record" request src=manager dst=journal endpoint=journal.interface method=Append {
            txId : "20251203T200500Z-0008", amountCents : 5550,
            currency : "RUB", approved : true
        }
        grant "Journal signals integrity error" response src=journal dst=manager endpoint=journal.interface method=Append {
            ok : false
        }
    }

    sequence "receipt-blocked" {
        grant "ControlSys refuses to print" request src=manager dst=output endpoint=output.interface method=ShowError {
            message : "Журнал недоступен"
        }
    }
}

assert "negative_corrupted_update" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        storage <- execute src=einit dst=controlsys.UpdateStorage
        verifier <- execute src=einit dst=controlsys.UpdateVerifier
    }

    sequence "corrupted-image" {
        grant "ControlSys pushes suspicious chunk" request src=manager dst=storage endpoint=storage.interface method=Append {
            chunkIndex : 1, chunkTotal : 2, chunkSize : 1048576,
            version : "1.0.9"
        }
        grant "Storage declines append" response src=storage dst=manager endpoint=storage.interface method=Append {
            accepted : false
        }
    }

    sequence "verifier-fails" {
        grant "Verifier sees invalid signature" request src=manager dst=verifier endpoint=verifier.interface method=Verify {
            version : "1.0.9", totalSize : 1048576, signatureOk : false
        }
        grant "Verifier rejects install" response src=verifier dst=manager endpoint=verifier.interface method=Verify {
            ok : false
        }
    }
}

assert "negative_card_data_corruption" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        cardverif <- execute src=einit dst=controlsys.CardVerifier
    }

    sequence "invalid-track" {
        grant "ControlSys forwards damaged card data" request src=manager dst=cardverif endpoint=cardverif.interface method=CheckCard {
            panMasked : "4256********9310", expiry : "2712",
            holder : "CARDHOLDER", emvOk : false
        }
        grant "Card verifier rejects corrupted track" response src=cardverif dst=manager endpoint=cardverif.interface method=CheckCard {
            accepted : false
        }
    }
}

assert "negative_replayed_bank_response" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        statusverif <- execute src=einit dst=controlsys.StatusVerifier
    }

    sequence "replay-detected" {
        grant "Out-of-order sequence blocked" request src=manager dst=statusverif endpoint=statusverif.interface method=Validate {
            txId : "20251203T202000Z-0010", seqNumber : 1,
            approved : true, latencyMs : 5
        }
        grant "Status verifier signals REPLAY" response src=statusverif dst=manager endpoint=statusverif.interface method=Validate {
            ok : false
        }
    }
}

assert "negative_receipt_without_journal" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        journal <- execute src=einit dst=controlsys.Journal
        output <- execute src=einit dst=controlsys.OutputController
    }

    sequence "journal-missing" {
        grant "ControlSys polls journal" request src=manager dst=journal endpoint=journal.interface method=Append {
            txId : "20251203T203000Z-0011", amountCents : 1000,
            currency : "RUB", approved : true
        }
        grant "Journal fails to persist" response src=journal dst=manager endpoint=journal.interface method=Append {
            ok : false
        }
    }

    sequence "print-blocked" {
        grant "ControlSys blocks receipt" request src=manager dst=output endpoint=output.interface method=ShowError {
            message : "Нельзя печатать без записи"
        }
    }
}

assert "negative_power_drop_before_card" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        inputguard <- execute src=einit dst=controlsys.InputGuard
    }

    sequence "battery-low" {
        grant "Heartbeat reports low power" request src=manager dst=inputguard endpoint=inputguard.interface method=Heartbeat {
            networkOk : true, pingOk : true, powerOk : false,
            signalStrength : 80, soc : 5
        }
        grant "InputGuard denies continuation" response src=inputguard dst=manager endpoint=inputguard.interface method=Heartbeat {
            powerReady : false, networkReady : true
        }
    }
}

assert "negative_update_low_battery" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        inputguard <- execute src=einit dst=controlsys.InputGuard
        installer <- execute src=einit dst=controlsys.UpdateInstaller
    }

    sequence "battery-warning" {
        grant "Heartbeat reports low battery" request src=manager dst=inputguard endpoint=inputguard.interface method=Heartbeat {
            networkOk : true, pingOk : true, powerOk : false,
            signalStrength : 70, soc : 4
        }
        grant "InputGuard orders to halt update" response src=inputguard dst=manager endpoint=inputguard.interface method=Heartbeat {
            powerReady : false, networkReady : true
        }
    }

    sequence "install-aborted" {
        grant "ControlSys attempts install" request src=manager dst=installer endpoint=installer.interface method=Install {
            version : "1.0.1", totalSize : 2097152, allow : 0
        }
        grant "Installer aborts due to power" response src=installer dst=manager endpoint=installer.interface method=Install {
            ok : 0
        }
    }
}

assert "negative_third_party_app" {
    setup {
        core <- execute dst=kl.core.Core
        einit <- execute src=core dst=Einit
        manager <- execute src=einit dst=controlsys.ControlSys
        cardverif <- execute src=einit dst=controlsys.CardVerifier
    }

    sequence "forged-source" {
        grant "ControlSys demands trusted source" request src=manager dst=cardverif endpoint=cardverif.interface method=CheckCard {
            panMasked : "4030********1111", expiry : "2412",
            holder : "UNKNOWN", emvOk : true
        }
        grant "Card verifier rejects third-party module" response src=cardverif dst=manager endpoint=cardverif.interface method=CheckCard {
            accepted : false
        }
    }
}
